# Copy to .env.local (never commit real values) and fill in.

# Cloudinary — stores blog posts and every uploaded image, video and file.
# Find these at https://console.cloudinary.com → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: the Cloudinary folder everything goes in (default: krold-blog)
# CLOUDINARY_FOLDER=krold-blog

# Blog admin login at /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# A long random string (32+ characters) that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Contact form → Google Sheet + owner email, via the Apps Script in google-apps-script/contact-form.gs
# (setup steps are at the top of that file).
# The Web app URL from Deploy → Manage deployments (ends in /exec)
CONTACT_SCRIPT_URL=
# A long random string; the same value goes in the script's Script Properties as CONTACT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_SCRIPT_SECRET=
# Who gets an email for each enquiry (comma-separate for more than one)
CONTACT_NOTIFY_TO=
